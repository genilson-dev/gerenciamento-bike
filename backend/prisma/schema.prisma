generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuário do sistema (admin, funcionário, etc.)
model User {
  id        String   @id @default(uuid()) // Chave primária
  name      String   // Nome do usuário
  email     String   @unique // Email único
  password  String   // Senha criptografada
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  orders    Order[]  // Relação: usuário pode ter várias ordens
  @@map("users")
}


// Categoria de produtos (ex: peças, acessórios)
model Category {
  id        String   @id @default(uuid()) // Chave primária
  name     String   @unique // Nome único da categoria
  products Product[] // Relação: categoria pode ter vários produtos
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  @@map("categories")
}

// Produto vendido ou utilizado em ordens
model Product {
 id        String   @id @default(uuid()) // Chave primária
  name       String   // Nome do produto
  price      String    // Preço do produto
  category_id String   // Chave estrangeira para categoria
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  category   Category @relation(fields: [category_id], references: [id]) // Relação com categoria
  orders     OrderItem[] // Relação: produto pode estar em vários itens de ordem
  @@map("products")
}
// Bike cadastrada no sistema
model Bike {
  id        String   @id @default(uuid()) // Chave primária
  model     String   // Modelo da bike
  owner_id   String   // Chave estrangeira para cliente
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  owner     Client   @relation(fields: [owner_id], references: [id]) // Relação com cliente (dono)
  orders    Order[]  // Relação: bike pode estar em várias ordens
  @@map("bikes")
}
// Cliente do sistema
model Client {
  id        String   @id @default(uuid()) // Chave primária
  name      String   // Nome do cliente
  email     String   @unique // Email único do cliente
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  bikes     Bike[]   // Relação: cliente pode ter várias bikes
  orders    Order[]  // Relação: cliente pode ter várias ordens
  @@map("clients")
}

// Ordem de serviço (serviços realizados, status, etc.)
model Order {
  id        String   @id @default(uuid()) // Chave primária
  status     String     // Status da ordem (aberto, encerrado, draft, etc.)
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  client_id   String     // Chave estrangeira para cliente
  client     Client     @relation(fields: [client_id], references: [id]) // Relação com cliente
  user_id     String     // Chave estrangeira para usuário
  user       User       @relation(fields: [user_id], references: [id]) // Relação com usuário
  bike_id     String     // Chave estrangeira para bike
  bike       Bike       @relation(fields: [bike_id], references: [id]) // Relação com bike
  items      OrderItem[] // Relação: ordem pode ter vários itens
  @@map("orders")
}

// Item de uma ordem (produto, quantidade, etc.)
model OrderItem {
  id        String   @id @default(uuid()) // Chave primária
  order_id   String   // Chave estrangeira para ordem
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  order     Order    @relation(fields: [order_id], references: [id]) // Relação com ordem
  product_id String   // Chave estrangeira para produto
  product   Product  @relation(fields: [product_id], references: [id]) // Relação com produto
  quantity  Int      // Quantidade do produto na ordem
  @@map("order_items")
}

// Músico do sistema
model Musico {
  id                    String   @id @default(uuid()) // Chave primária
  name                  String   // Nome do músico
  sexo                  String   // Sexo (M/F)
  encarregado_local     Boolean  // Encarregado local (opcional)
  encarregado_regional  Boolean  // Encarregado regional (opcional)
  instrutor             Boolean  // Instrutor(a) (opcional)
  examinadora           Boolean  // Examinadora (opcional)
  aluno          Boolean // Se é aluno
  ensaios        Boolean // Se participa dos ensaios
  rjm            Boolean // Se participa das RJM
  cultos_oficiais Boolean // Se participa dos cultos oficiais
  oficializado   Boolean // Se é oficializado  
  possui_instrumento_proprio Boolean // Se possui instrumento próprio
  instrumento Boolean // Qual instrumento toca
  tonalidade            String  // Qual a tonalidade (opcional)
  created_at            DateTime @default(now()) // Data de criação
  update_at             DateTime @updatedAt // Data de alteração
  
  @@map("musicos")
}


model Organista {
  id                    String   @id @default(uuid()) // Chave primária
  name                  String   // Nome do músico
  sexo                  String   // Sexo (M/F)  
  instrutora            Boolean  // Instrutor(a) (opcional)
  examinadora           Boolean  // Examinadora (opcional)
  status_rjm            Boolean // Se participa das RJM
  oficializado   Boolean // Se é oficializado
  aluna       Boolean // Se é aluna organista
  rjm         Boolean // Se participa das RJM como organista
  cultos_oficiais Boolean // Se participa dos cultos oficiais como organista
  organista_oficializada Boolean // Se é oficializada como organista
  possui_instrumento_proprio Boolean // Se possui instrumento próprio
  instrumento Boolean // Qual instrumento toca
  tonalidade            String?  // Qual a tonalidade (opcional)
  created_at            DateTime @default(now()) // Data de criação
  update_at             DateTime @updatedAt // Data de alteração
  
  @@map("organistas")
}
