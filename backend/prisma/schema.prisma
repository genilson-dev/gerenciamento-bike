generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // ou "mysql" conforme seu banco
  url      = env("DATABASE_URL")
}

// Usuário do sistema (admin, funcionário, etc.)
model User {
  id        String   @id @default(uuid()) // Chave primária
  name      String   // Nome do usuário
  email     String   @unique // Email único
  password  String   // Senha criptografada
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  orders    Order[]  // Relação: usuário pode ter várias ordens
  @@map("users")
}

// Categoria de produtos (ex: peças, acessórios)
model Category {
  id        String   @id @default(uuid()) // Chave primária
  name     String   @unique // Nome único da categoria
  products Product[] // Relação: categoria pode ter vários produtos
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  @@map("categories")
}

// Produto vendido ou utilizado em ordens
model Product {
 id        String   @id @default(uuid()) // Chave primária
  name       String   // Nome do produto
  price      Float    // Preço do produto
  categoryId String   // Chave estrangeira para categoria
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  category   Category @relation(fields: [categoryId], references: [id]) // Relação com categoria
  orders     OrderItem[] // Relação: produto pode estar em vários itens de ordem
  @@map("products")
}
// Bike cadastrada no sistema
model Bike {
  id        String   @id @default(uuid()) // Chave primária
  model     String   // Modelo da bike
  ownerId   String   // Chave estrangeira para cliente
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  owner     Client   @relation(fields: [ownerId], references: [id]) // Relação com cliente (dono)
  orders    Order[]  // Relação: bike pode estar em várias ordens
  @@map("bikes")
}
// Cliente do sistema
model Client {
  id        String   @id @default(uuid()) // Chave primária
  name      String   // Nome do cliente
  email     String   @unique // Email único do cliente
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  bikes     Bike[]   // Relação: cliente pode ter várias bikes
  orders    Order[]  // Relação: cliente pode ter várias ordens
  @@map("clients")
}

// Ordem de serviço (serviços realizados, status, etc.)
model Order {
  id        String   @id @default(uuid()) // Chave primária
  status     String     // Status da ordem (aberto, encerrado, draft, etc.)
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  clientId   String     // Chave estrangeira para cliente
  client     Client     @relation(fields: [clientId], references: [id]) // Relação com cliente
  userId     String     // Chave estrangeira para usuário
  user       User       @relation(fields: [userId], references: [id]) // Relação com usuário
  bikeId     String     // Chave estrangeira para bike
  bike       Bike       @relation(fields: [bikeId], references: [id]) // Relação com bike
  items      OrderItem[] // Relação: ordem pode ter vários itens
  @@map("orders")
}

// Item de uma ordem (produto, quantidade, etc.)
model OrderItem {
  id        String   @id @default(uuid()) // Chave primária
  orderId   String   // Chave estrangeira para ordem
  created_at DateTime @default(now()) // Data de criação
  update_at DateTime @default(now()) // Data de alteração
  order     Order    @relation(fields: [orderId], references: [id]) // Relação com ordem
  productId String   // Chave estrangeira para produto
  product   Product  @relation(fields: [productId], references: [id]) // Relação com produto
  quantity  Int      // Quantidade do produto na ordem
  @@map("order_items")
}